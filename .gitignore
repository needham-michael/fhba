__pycache__/
*.py[oc]
build/
dist/
# Ignore generated wheels but track pre-built ones for packages with no PyPI
# binary for Python 3.14 / Windows (e.g. pyhdf).
wheels/*
!wheels/pyhdf-*.whl
!wheels/cartopy-*.whl
!wheels/numcodecs-*.whl
*.egg-info
.ipynb_checkpoints

# Virtual environments
.venv
